# Arabic translations for django-unfold's own UI strings (django-unfold==0.104.1).
#
# Unfold ships zero locale/ catalogs of its own for ANY language — see the
# RTL/colors diagnostic. Django core and django.contrib.admin already ship a
# complete Arabic catalog, so this file covers only the msgids that are
# unique to Unfold's templates and therefore untranslated by those. Msgids
# were extracted with the real `django-admin makemessages` (not hand-typed)
# against copies of the exact Unfold template files, to avoid whitespace/
# HTML mismatches that would silently fail to match at runtime. Two strings
# Unfold reuses verbatim from Django's own admin catalog ("Add %(name)s",
# "Show all") are intentionally left out here so this file can't drift out
# of sync with core's translation of the same msgid.
msgid ""
msgstr ""
"Project-Id-Version: rahhal-admin-unfold-strings\n"
"Report-Msgid-Bugs-To: \n"
"POT-Creation-Date: 2026-09-15 18:49+0300\n"
"PO-Revision-Date: 2026-09-15 18:49+0300\n"
"Last-Translator: \n"
"Language-Team: Arabic\n"
"Language: ar\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=6; plural=n==0 ? 0 : n==1 ? 1 : n==2 ? 2 : n%100>=3 "
"&& n%100<=10 ? 3 : n%100>=11 && n%100<=99 ? 4 : 5;\n"

