DEBUG=False
SECRET_KEY=change-me-to-a-real-random-secret-key
ALLOWED_HOSTS=your-domain-or-ip-here

USE_POSTGRES=True
DB_ENGINE=django.db.backends.postgresql
DB_NAME=ufuq
DB_USER=ufuq_user
DB_PASSWORD=change-me-to-a-real-password
DB_HOST=db
DB_PORT=5432

# Read by the official postgres image itself to initialize the `db`
# container on first run — must match DB_NAME/DB_USER/DB_PASSWORD above
# exactly (same values, different variable names; this duplication is
# required by the postgres image's own design, not a mistake).
POSTGRES_DB=ufuq
POSTGRES_USER=ufuq_user
POSTGRES_PASSWORD=change-me-to-a-real-password
